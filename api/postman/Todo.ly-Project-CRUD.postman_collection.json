{
  "info": {
    "_postman_id": "99f87ea6-9976-479c-a327-2f87e423ab2e",
    "name": "Todo.ly - User and Project CRUD with Token",
    "description": "Flujo manual equivalente al escenario Cucumber: crea usuario, obtiene token y ejecuta CRUD de proyecto.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Crear usuario",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"Email\": \"{{email}}\",\n  \"FullName\": \"API Testing Candidate\",\n  \"Password\": \"{{password}}\"\n}"
        },
        "url": "{{baseUrl}}/api/user.json"
      },
      "event": [
        {"listen": "prerequest", "script": {"type": "text/javascript", "exec": [
          "pm.environment.set('email', `apitesting+${Date.now()}@example.com`);",
          "pm.environment.unset('token');",
          "pm.environment.unset('projectId');"
        ]}},
        {"listen": "test", "script": {"type": "text/javascript", "exec": [
          "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
          "pm.test('Email creado', () => pm.expect(pm.response.json().Email).to.eql(pm.environment.get('email')));"
        ]}}
      ]
    },
    {
      "name": "02 - Obtener token",
      "request": {
        "auth": {"type": "basic", "basic": [
          {"key": "username", "value": "{{email}}", "type": "string"},
          {"key": "password", "value": "{{password}}", "type": "string"}
        ]},
        "method": "GET",
        "url": "{{baseUrl}}/api/authentication/token.json"
      },
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "pm.expect(body.TokenString).to.be.a('string').and.not.empty;",
        "pm.environment.set('token', body.TokenString);"
      ]}}]
    },
    {
      "name": "03 - Crear proyecto",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Token", "value": "{{token}}", "type": "text"}
        ],
        "body": {"mode": "raw", "raw": "{\n  \"Content\": \"Proyecto API Clean\"\n}"},
        "url": "{{baseUrl}}/api/projects.json"
      },
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "pm.expect(body.Content).to.eql('Proyecto API Clean');",
        "pm.environment.set('projectId', body.Id);"
      ]}}]
    },
    {
      "name": "04 - Consultar proyecto",
      "request": {
        "method": "GET",
        "header": [{"key": "Token", "value": "{{token}}", "type": "text"}],
        "url": "{{baseUrl}}/api/projects/{{projectId}}.json"
      },
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
        "pm.expect(pm.response.json().Content).to.eql('Proyecto API Clean');"
      ]}}]
    },
    {
      "name": "05 - Actualizar proyecto",
      "request": {
        "method": "PUT",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Token", "value": "{{token}}", "type": "text"}
        ],
        "body": {"mode": "raw", "raw": "{\n  \"Content\": \"Proyecto API Clean Actualizado\"\n}"},
        "url": "{{baseUrl}}/api/projects/{{projectId}}.json"
      },
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
        "pm.expect(pm.response.json().Content).to.eql('Proyecto API Clean Actualizado');"
      ]}}]
    },
    {
      "name": "06 - Eliminar proyecto",
      "request": {
        "method": "DELETE",
        "header": [{"key": "Token", "value": "{{token}}", "type": "text"}],
        "url": "{{baseUrl}}/api/projects/{{projectId}}.json"
      },
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
        "pm.expect(pm.response.json().Deleted).to.eql(true);"
      ]}}]
    }
  ]
}
